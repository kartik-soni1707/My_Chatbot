# Copy this to .env and fill in real values. NEVER commit .env.

# Your LLM / embeddings provider key (this is the one to protect + set a spend cap on)
OPENAI_API_KEY=sk-...

# Your hosted Postgres connection string (must have the pgvector extension available)
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# Comma-separated list of frontend origins allowed to call this API (CORS)
# e.g. https://yoursite.com,https://www.yoursite.com
ALLOWED_ORIGINS=http://localhost:3000
